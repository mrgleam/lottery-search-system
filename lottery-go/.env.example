LOTTERY_ADDR=:8080
LOTTERY_DSN=postgres://lottery:lottery@localhost:5432/lottery?sslmode=disable
LOTTERY_LEASE=2m
LOTTERY_MAX_CONNS=20
LOTTERY_REAP_EVERY=30s
LOTTERY_REAP_BATCH=5000
LOTTERY_SHUTDOWN_GRACE=15s

# Availability hint (the in-memory layer in front of Postgres)
LOTTERY_USE_HINT=true
LOTTERY_HINT_REFRESH=30s
# LISTEN/NOTIFY needs schema_notify.sql applied, and holds one pooled connection
LOTTERY_USE_LISTEN=false
